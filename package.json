{
  "name": "flow-pilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:mac": "npm run build && node scripts/package-desktop.mjs mac",
    "desktop:linux": "npm run build && node scripts/package-desktop.mjs linux",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:app": "node --test tests/schedule.test.mjs tests/task-schedule.test.mjs tests/desktop-assets.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
