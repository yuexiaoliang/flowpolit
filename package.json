{
  "name": "flow-pilot",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && pnpm build:desktop-runtime && node scripts/prepare-sites-build.mjs",
    "build:desktop-runtime": "node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm build && electron .",
    "desktop:mac": "pnpm build && node scripts/package-desktop.mjs mac",
    "desktop:linux": "pnpm build && node scripts/package-desktop.mjs linux",
    "preview": "vite preview",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"tests/*.mts\" vite.config.ts",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"tests/*.mts\" vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm test:app && pnpm test:sites",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:app": "tsx --test tests/schedule.test.mts tests/task-schedule.test.mts tests/desktop-assets.test.mts tests/web-page.test.mts"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@flowpilot/domain": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^44.4.5",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "6.4.2"
  }
}
